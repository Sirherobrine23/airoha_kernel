menu "Optical frontend support"

config OPTICAL_FRONTEND
	tristate "Generic optical frontend core"
	help
	  Generic provider/consumer framework for soldered optical frontends such
	  as laser-diode drivers, limiting amplifiers and APD controllers used by
	  PON and other optical network devices.

	  The core intentionally sits beside PHYLIB/phylink: it represents the
	  analog optical frontend, not an Ethernet PHY or a serial PCS.

if OPTICAL_FRONTEND

config OPTICAL_FRONTEND_HWMON
	bool "Expose optical telemetry through hwmon"
	depends on HWMON
	default y
	help
	  Export normalized temperature, voltage, laser bias and Tx/Rx optical
	  power measurements through hwmon when a frontend provides them.

	  Alarm state and provider-supplied low/high thresholds are exported when
	  available. Say Y when standard hwmon userspace should monitor optics.

endif

source "drivers/net/optical/airoha/Kconfig"
source "drivers/net/optical/semtech/Kconfig"

endmenu
