config GN25L95_PHY
	tristate "Semtech GN25L95/GN25L98 xPON optical frontend"
	depends on I2C
	select FW_LOADER
	select REGMAP_I2C
	select OPTICAL_FRONTEND
	help
	  Support the Semtech GN25L95 and GN25L98 2.5 Gbit/s burst-mode laser
	  drivers and limiting post amplifiers. The driver is an independent
	  provider of the generic optical frontend subsystem and is not tied to
	  Airoha MAC or PHY drivers.
