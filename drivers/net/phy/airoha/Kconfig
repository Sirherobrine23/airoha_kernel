config AIROHA_LDDLA_PHY
	tristate "Airoha EN757x xPON optical frontends"
	depends on I2C
	select FW_LOADER
	select PHY_COMMON_PROPS
	select OPTICAL_FRONTEND
	select OPTICAL_FRONTEND_SFP_COMPAT
	default n
	help
	  Support Airoha EN757x laser-driver / limiting-amplifier devices as
	  providers of the generic optical frontend subsystem.

if AIROHA_LDDLA_PHY

config EN7570_PHY
	bool "Airoha EN7570 optical frontend"
	default y
	help
	  Enable the EN7570 provider in the shared Airoha LDDLA driver.

config EN7571_PHY
	bool "Airoha EN7571 optical frontend"
	default y
	help
	  Enable the EN7571 provider in the shared Airoha LDDLA driver.

config EN7572_PHY
	bool "Airoha EN7572 / AN8901 optical frontend"
	default y
	help
	  Enable the EN7572 and AN8901 providers in the shared Airoha LDDLA driver.

endif
