config AIROHA_LDDLA_PHY
	tristate "xPON laser-driver / limiting-amplifier devices"
	select PHY_COMMON_PROPS
	default n
	help
	  Support optical front-end controllers used with Airoha/EcoNet xPON MACs.

if AIROHA_LDDLA_PHY

config EN7570_PHY
	bool "xPON PHY for EN7570"
	depends on AIROHA_LDDLA_PHY
	help
	 en7570

config EN7571_PHY
	bool "xPON PHY for EN7571"
	depends on AIROHA_LDDLA_PHY
	help
	 en7571

config EN7572_PHY
	bool "xPON PHY for EN7572"
	depends on AIROHA_LDDLA_PHY
	help
	 en7572

config GN25L95_PHY
	bool "Semtech GN25L95 xPON optical frontend"
	depends on AIROHA_LDDLA_PHY
	select FW_LOADER
	select REGMAP_I2C
	help
	  Support the Semtech GN25L95 2.5 Gbit/s burst-mode laser driver
	  and limiting post amplifier. The device exposes SFF-8472 DDMI
	  measurements over I2C and is used in GPON/EPON BOSA-on-board
	  optical frontends.

endif
