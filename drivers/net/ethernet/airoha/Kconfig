config NET_VENDOR_AIROHA
	bool "Airoha/EcoNet devices"
	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
	help
	  If you have a Airoha/EcoNet SoC with ethernet, say Y.

if NET_VENDOR_AIROHA

config NET_AIROHA_COMMON
	tristate
	help
	  Shared helpers used by the Airoha ARM and EcoNet MIPS frame-engine
	  Ethernet drivers.

config NET_AIROHA
	tristate "Airoha SoC Gigabit Ethernet support"
	depends on NET_DSA || !NET_DSA
	select NET_AIROHA_COMMON
	select NET_AIROHA_NPU
	select PAGE_POOL
	select PHYLINK
	help
	  This driver supports the gigabit ethernet MACs in the
	  Airoha SoC family.

config NET_ECONET
	tristate "EcoNet SoC Gigabit Ethernet support"
	depends on NET_DSA || !NET_DSA
	depends on OF
	select NET_AIROHA_COMMON
	select PAGE_POOL
	select PHYLINK
	help
	  This driver supports the gigabit ethernet MACs in the
	  EcoNet SoC family.

config NET_AIROHA_NPU
	tristate "Airoha NPU support"
	depends on ARCH_AIROHA
	select WANT_DEV_COREDUMP
	select REGMAP_MMIO
	help
	  This driver supports Airoha Network Processor (NPU) available
	  on the Airoha Soc family.

config NET_AIROHA_FLOW_STATS
	default y
	bool "Airoha flow stats"
	depends on NET_AIROHA && NET_AIROHA_NPU
	help
	  Enable Airoha flowtable statistic counters.

config NET_AIROHA_SOC_WED
	bool "Airoha/EcoNet WED support"
	depends on PCI
	select NET_MEDIATEK_WED_COMMON
	help
	  Enable WiFi Ethernet Datapath (WED) hardware offload for the
	  SoC. When enabled, mt76 WiFi drivers can offload wireless
	  transmit processing through the WED engine rather than taking
	  the slow path through the CPU.

	  If unsure, say N.

config AIROHA_XPON_V1
	tristate "Airoha/EcoNet xPON MAC driver"
	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
	depends on NET_AIROHA
	depends on OF
	depends on SFP
	depends on AIROHA_LDDLA_PHY || AIROHA_LDDLA_PHY=n
	depends on MFD_SYSCON
	select PHY_AIROHA_XPON
	select OMCI
	help
	  Driver for the shared xPON MAC complex found in Airoha/EcoNet SoCs.
	  GPON and EPON are implemented by one platform driver and selected by
	  the airoha,pon-mode device-tree property. GPON includes ITU-T G.984.3
	  activation/PLOAM and uses the in-kernel OMCI agent; EPON
	  includes IEEE 802.3 MPCP LLID registration and security support.

endif #NET_VENDOR_AIROHA
