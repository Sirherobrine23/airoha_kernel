config NET_VENDOR_AIROHA
	bool "Airoha devices"
	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
	help
	  If you have a Airoha or Econet SoC with ethernet, say Y.

if NET_VENDOR_AIROHA

config NET_AIROHA_NPU
	tristate "Airoha NPU support"
	depends on ARCH_AIROHA || COMPILE_TEST
	select WANT_DEV_COREDUMP
	select REGMAP_MMIO
	help
	  Support the Network Processor Unit available on newer Airoha SoCs.
	  The Ethernet and PPE drivers also work without this module by using
	  the CPU-direct PPE path. Enable this option when NPU firmware is
	  available and PPE statistics or firmware-assisted commits are needed.

config NET_AIROHA
	tristate "Airoha/EcoNet frame-engine Ethernet support"
	depends on OF
	select PHYLINK
	select PAGE_POOL
	imply NET_AIROHA_NPU if ARCH_AIROHA
	help
	  This driver supports the gigabit ethernet MACs in the
	  Airoha and Econet SoC family.

config NET_AIROHA_PPE_DEBUGFS
	bool
	default y
	depends on NET_AIROHA && DEBUG_FS
	help
	  Build the PPE debugfs interface for the shared Airoha/EcoNet
	  Ethernet driver.

config NET_AIROHA_FLOW_STATS
	default y
	bool "Airoha flow stats"
	depends on NET_AIROHA && NET_AIROHA_NPU
	help
	  Enable Airoha flowtable statistic counters.

config NET_AIROHA_SOC_WED
	bool "Airoha WED support"
	depends on NET_AIROHA && !NET_AIROHA_WHNAT && PCI
	select NET_MEDIATEK_WED_COMMON
	help
	  Enable WiFi Ethernet Datapath (WED) hardware offload.
	  When enabled, mt76 WiFi drivers can offload wireless
	  transmit processing through the WED engine rather than
	  taking the slow path through the CPU.

	  If unsure, say N.

config NET_AIROHA_WHNAT
	bool "EcoNet PPE WHNAT"
	depends on NET_AIROHA && (SOC_ECONET_EN751221 || COMPILE_TEST)
	select CFG80211_HEADERS
	help
	  Let PPE forward NAT flows from and to WiFi netdevs
	  whose radios have no WED support.

	  If unsure, say N.

config AIROHA_XPON
	tristate "Airoha xPON MAC driver"
	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
	depends on NET_AIROHA
	depends on OF
	depends on SFP
	depends on OPTICAL_FRONTEND
	depends on MFD_SYSCON
	select PHY_AIROHA_XPON
	select XPON
	select XPON_OMCI
	select XPON_OAM
	help
	  Enable support for PON on ethernet driver for SoC familys support

config AIROHA_XDSL
	tristate "EcoNet xDSL frontend"
	depends on SOC_ECONET_EN751221 || SOC_ECONET_EN751627 || COMPILE_TEST
	depends on NET_AIROHA
	depends on OF
	help
	  Add support for xDSL Ethernet support on SoC Family have xDSL controllers

endif # NET_VENDOR_AIROHA
