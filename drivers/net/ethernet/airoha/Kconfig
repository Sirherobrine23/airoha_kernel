config NET_VENDOR_AIROHA
	bool "Airoha/EcoNet devices"
	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
	help
	  Enable Ethernet drivers for the Airoha ARM and EcoNet MIPS frame
	  engines.

if NET_VENDOR_AIROHA

config NET_AIROHA_NPU
	tristate "Airoha NPU support"
	depends on ARCH_AIROHA || COMPILE_TEST
	select WANT_DEV_COREDUMP
	select REGMAP_MMIO
	help
	  Support the Network Processor Unit available on newer Airoha SoCs.
	  The Ethernet and PPE drivers also work without this module by using
	  the CPU-direct PPE path. Enable this option when NPU firmware is
	  available and PPE statistics or firmware-assisted commits are needed.

config NET_AIROHA
	tristate "Airoha/EcoNet frame-engine Ethernet support"
	depends on OF
	select PHYLINK
	select PAGE_POOL
	imply NET_AIROHA_NPU if ARCH_AIROHA
	help
	  Support the shared Airoha/EcoNet frame-engine Ethernet datapath,
	  including generation-1 EN751221/EN7528 and generation-2
	  EN7523/EN7581/AN7583 SoCs. The hardware generation is selected
	  from the device-tree compatible and SoC data at runtime. QDMA, GDM,
	  PPE and phylink infrastructure are built as one driver so both
	  generations follow the same lifecycle and common interfaces.

config NET_AIROHA_KUNIT_TEST
	bool "Airoha xPON service table tests" if !KUNIT_ALL_TESTS
	depends on KUNIT=y && NET_AIROHA=y
	default KUNIT_ALL_TESTS
	help
	  Test shared classifier rules, cookie lifetime, full-table updates
	  and failed replacements without Ethernet or optical hardware.
	  Include cookie bucket compaction after fragmented deletions.
	  These tests do not validate QDMA descriptors or PON activation.

config NET_AIROHA_PTM_KUNIT_TEST
	bool "EcoNet PTM receive metadata tests" if !KUNIT_ALL_TESTS
	depends on KUNIT=y
	default KUNIT_ALL_TESTS
	help
	  Test EN7512/EN7516 PTM receive descriptor validation without
	  hardware. Check error bits, unsupported control frames and the
	  single-line, single-bearer path restriction. These tests do not
	  validate DMA, DSL training or packet forwarding on a modem.

config NET_AIROHA_DMT_KUNIT_TEST
	bool "EcoNet DMT firmware data tests" if !KUNIT_ALL_TESTS
	depends on KUNIT=y
	select CRC32
	default KUNIT_ALL_TESTS
	help
	  Test data-only AFE firmware parsing, register field validation and
	  package decoding without DSL hardware. Does not validate AFE MMIO,
	  analog calibration, reset timing or modem training.
	  Both firmware formats can be exercised on UML or other KUnit hosts.

config NET_AIROHA_PPE_DEBUGFS
	bool
	default y
	depends on NET_AIROHA && DEBUG_FS
	help
	  Build the PPE debugfs interface for the shared Airoha/EcoNet
	  Ethernet driver.

config NET_AIROHA_FLOW_STATS
	default y
	bool "Airoha flow stats"
	depends on NET_AIROHA && NET_AIROHA_NPU
	help
	  Enable Airoha flowtable statistic counters.

config NET_AIROHA_SOC_WED
	bool "Airoha WED v1 support"
	depends on NET_AIROHA && PCI
	select NET_MEDIATEK_WED_COMMON
	help
	  Enable WiFi Ethernet Datapath (WED) hardware offload for the
	  EN751221, EN7528 and EN7523 SoCs. When enabled, mt76 WiFi drivers can
	  offload wireless transmit processing through the WED engine rather
	  than taking the CPU path.

	  If unsure, say N.

config NET_AIROHA_WHNAT
	bool "EcoNet EN751221 WHNAT (PPE offload for WiFi without WED)"
	depends on NET_AIROHA && (ECONET || COMPILE_TEST)
	select CFG80211_HEADERS
	help
	  Let the EN751221 PPE forward NAT flows from and to WiFi netdevs
	  whose radios have no WED support (MT7603, MT76x2), like the vendor
	  WHNAT driver: mt76 hands received frames to the PPE through the LAN
	  QDMA, and the PPE returns frames of flows bound towards a WiFi
	  interface to the CPU, which queues them straight to that interface.
	  Netdevice events give the WiFi interfaces their slots, so mt76 only
	  offers received frames through en75_whnat_upstream_early(). Setting
	  the whnat_auto_vifs module parameter to 0 makes the slots come from
	  en75_whnat_register_vif() calls instead. The offload is on whenever
	  a PPE is active; clearing whnat_enable stops offering new frames.

	  If unsure, say N.

config AIROHA_XPON_V1
	tristate "Airoha/EcoNet xPON MAC driver"
	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
	depends on NET_AIROHA
	depends on OF
	depends on SFP
	depends on OPTICAL_FRONTEND || OPTICAL_FRONTEND=n
	depends on MFD_SYSCON
	select PHY_AIROHA_XPON
	select XPON
	select XPON_OMCI
	select XPON_OAM
	help
	  Driver for the shared xPON MAC complex found in Airoha/EcoNet SoCs.
	  GPON and EPON are implemented by one platform driver and exposed
	  through the generic xPON subsystem. GPON includes ITU-T G.984.3
	  activation/PLOAM and uses the in-kernel OMCI agent; EPON includes
	  IEEE 802.3 MPCP LLID registration and security support.

	  EN7580 XGS-PON support currently prepares the 10G MAC in O1 and
	  exposes its register status through debugfs. PHY/PMA initialization,
	  authenticated PLOAM activation and the 10G datapath are not implemented
	  yet; the driver keeps automatic upstream replies and MAC interrupts
	  disabled and does not register an OMCI transport for this mode.

config AIROHA_XDSL
	tristate "EcoNet EN7512/EN7516 xDSL/PTM frontend"
	depends on ECONET || COMPILE_TEST
	depends on NET_AIROHA
	depends on OF
	depends on MFD_SYSCON
	select CRC32
	select FW_LOADER
	select XPON
	select XPON_OMCI
	help
	  Build the initial xDSL frontend for the EcoNet EN751221 (EN7512)
	  and EN751627 (EN7516) SoC families. The driver owns the DMT and PTM-TC
	  resources and connects their reset, interrupt and netdev
	  lifecycle to the GDM2 Ethernet datapath.

	  The proprietary legacy module embeds the complete G.hs/ADSL/VDSL
	  training and DSP implementation. Until a native line engine is
	  implemented, this driver keeps the DMT interrupts masked and carrier
	  down after preparing the PTM datapath.
	  Validated AFE data is loaded with request_firmware. Experimental
	  AFE register initialization requires afe_bringup=1 and is not
	  equivalent to modem calibration or DSL training.
	  Both SoCs use airoha_xdsl.c and expose their local line status through
	  the OMCI access-management Netlink commands. An unavailable line
	  engine is reported explicitly and retraining is not advertised.

endif # NET_VENDOR_AIROHA
